{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/nestjs"
  ],
  "formatter": {
    "indentStyle": "tab"
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        // Re-sorting object literals changes fixtures whose order is the
        // subject and any object whose iteration order is behavior.
        "useSortedKeys": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      // New in Ultracite 6: several hundred pre-existing sites each. Off until
      // the codebase is migrated rule by rule; do not add new violations.
      "performance": {
        "noAwaitInLoops": "off",
        "noJsxPropsBind": "off"
      },
      "style": {
        "noIncrementDecrement": "off",
        "noNonNullAssertion": "off",
        "useConsistentMethodSignatures": "off",
        "useDestructuring": "off"
      },
      "suspicious": {
        "noControlCharactersInRegex": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "files": {
    "includes": [
      "!!**/tests/fixtures",
      // Generated demo artifact served by the report viewer; stays minified.
      "!!**/public/demo-report.json",
      // Generated by demo/render-svg.ts; one line per element.
      "!!**/public/demo.svg",
      "!!**/.changeset",
      // Hand-formatted stylesheet split into cascade-ordered sheets.
      // Formatting rewrites it; noDescendingSpecificity fixes reorder rules.
      "!!**/src/report/ui/styles"
    ]
  }
}
