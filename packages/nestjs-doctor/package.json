{
  "name": "nestjs-doctor",
  "version": "0.9.3",
  "description": "Static analysis tool for NestJS that produces a health score with actionable diagnostics and an interactive report",
  "type": "module",
  "bin": {
    "nestjs-doctor": "./dist/cli/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/api/index.d.mts",
      "default": "./dist/api/index.mjs"
    },
    "./api": {
      "types": "./dist/api/index.d.mts",
      "default": "./dist/api/index.mjs"
    },
    "./report-ui": {
      "types": "./dist/report-ui/index.d.ts",
      "default": "./dist/report-ui/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postbuild": "node scripts/copy-skills.mjs",
    "smoke:packed": "node scripts/smoke-packed-install.mjs",
    "advisories:check": "node scripts/check-advisories.mjs",
    "build:browser": "tsdown --config tsdown.browser.config.ts",
    "prebuild": "pnpm run build:browser",
    "pretest": "pnpm run build:browser"
  },
  "keywords": [
    "nestjs",
    "nest",
    "static-analysis",
    "code-quality",
    "code-review",
    "module-graph",
    "dependency-graph",
    "circular-dependency",
    "architecture",
    "security",
    "diagnostic",
    "lint",
    "typescript",
    "devtools",
    "best-practices"
  ],
  "author": "RoloBits",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RoloBits/nestjs-doctor.git",
    "directory": "packages/nestjs-doctor"
  },
  "homepage": "https://www.nestjs.doctor",
  "bugs": {
    "url": "https://github.com/RoloBits/nestjs-doctor/issues"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.0.1",
    "react-dom": "19.2.3",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "ink": "^6.8.0",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "react": "19.2.3",
    "tinyglobby": "^0.2.17",
    "ts-morph": "^28.0.0",
    "yocto-spinner": "^1.2.2"
  }
}
